APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos local (por defecto): SQLite.
DB_CONNECTION=sqlite

# --- Supabase / PostgreSQL (Fase 0) ---
# Para usar Supabase, comenta DB_CONNECTION=sqlite de arriba y descomenta este bloque.
# Ver docs/supabase.md para los valores concretos del proyecto.
# DB_CONNECTION=pgsql
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require

# --- PGP interno (Fase 2) ---
# 'auto' usa el binario de GnuPG si está disponible; si no, cae a fallback (solo local/testing).
# El driver fallback NO proporciona cifrado real y está prohibido en producción.
PGP_DRIVER=auto
PGP_BINARY=gpg
PGP_GNUPG_HOME=storage/app/pgp/gpg
PGP_ALGORITHM=ed25519
PGP_KEY_PASSWORD=
PGP_IDENTITY="Plataforma BugBounty <seguridad@localhost>"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
