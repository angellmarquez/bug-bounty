APP_NAME=Huella
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos local (por defecto): SQLite.
DB_CONNECTION=sqlite

# --- Supabase / PostgreSQL (Fase 0) ---
# Para usar Supabase, comenta DB_CONNECTION=sqlite de arriba y descomenta este bloque.
# Ver docs/supabase.md para los valores concretos del proyecto.
# DB_CONNECTION=pgsql
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require
# Si en vez de la conexión directa (5432) usás el connection pooler de Supabase
# (host "aws-*.pooler.supabase.com", puerto 6543, modo "transaction"), dejá
# DB_POOLED=true (ya es el default en config/database.php) para que PDO emule los
# prepared statements del lado del cliente; si no, fallan session/cache/queue con
# "prepared statement ... does not exist". Si te conectás directo (5432, sin
# pooler) podés poner DB_POOLED=false.
# DB_POOLED=true

# --- PGP interno (Fase 2) ---
# 'auto' usa el binario de GnuPG si está disponible; si no, cae a fallback (solo local/testing).
# El driver fallback NO proporciona cifrado real y está prohibido en producción.
PGP_DRIVER=auto
PGP_BINARY=gpg
# En Windows, si tenés Git instalado, su gpg embebido (en .../Git/usr/bin) puede
# ganarle al de Gpg4win en el PATH y usar un gpg-agent incompatible con el otro.
# Para evitarlo, apuntá directo al binario real, por ejemplo:
# PGP_BINARY="C:/Program Files/GnuPG/bin/gpg.exe"
PGP_GNUPG_HOME=storage/app/pgp/gpg
PGP_ALGORITHM=ed25519
PGP_KEY_PASSWORD=
PGP_IDENTITY="Plataforma BugBounty <seguridad@localhost>"
# Secreto exclusivo para cifrar clave_privada en la base -- distinto de APP_KEY
# a propósito, así una fuga de APP_KEY no expone también las claves PGP.
# Generalo con: php artisan tinker --execute="echo 'base64:'.base64_encode(random_bytes(32));"
PGP_STORAGE_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fotos de evidencia (se guardan cifradas con PGP). En Render usar s3 (Supabase Storage): ver docs/render.md
ADJUNTOS_DISK=local
ADJUNTOS_MAX_KB=5120
ADJUNTOS_MAX_POR_ENTIDAD=10
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email delivery is disabled until a provider is configured.
MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
